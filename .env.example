# Supabase (required for Phase 1 auth)
# Copy this file to .env.local and fill in values from:
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Set to "true" to auto-load sample situation + call history on first dashboard visit
DEMO_AUTO_SEED=false
